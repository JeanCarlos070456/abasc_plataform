# Django
DEBUG=True
SECRET_KEY=troque-esta-chave-em-producao
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SECURE_SSL_REDIRECT=False

# Banco: deixe vazio em desenvolvimento para usar SQLite.
# No Supabase, use a conexão PostgreSQL do pooler com sslmode=require.
DATABASE_URL=
DB_SSL_REQUIRE=True

# Supabase Auth e Storage
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_NEWS=abasc-news
SUPABASE_STORAGE_BUCKET_AVATARS=abasc-avatars

# Contas locais de demonstração, somente em desenvolvimento
ENABLE_LOCAL_AUTH=True

# Identidade institucional
ABASC_CONTACT_EMAIL=abasc.comunica@gmail.com
ABASC_SITE_NAME=ABASC
ABASC_FULL_NAME=Associação de Bacharéis em Saúde Coletiva
